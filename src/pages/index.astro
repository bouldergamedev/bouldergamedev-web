---
import Layout from '../layouts/Layout.astro';
import Mountain from '../components/Mountain.astro';
import { site } from '../site.mjs';
---

<Layout>
	<div class="site-shell">
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title">Boulder<br />Game Dev</h1>
					<div class="hero-tagline">
						<p>{site.intro}</p>
						<p>For more info join us on <a class="discord-link" href={site.discord} target="_blank" rel="noopener noreferrer">Discord</a>.</p>
					</div>
					<nav class="hero-actions" aria-label="Community links">
						<a class="community-link" href={site.linktree} target="_blank" rel="noopener noreferrer">{site.linktree.replace('https://', '')} <span aria-hidden="true">↗</span></a>
					</nav>
				</div>
				<Mountain />
			</section>
		</main>
	</div>
</Layout>
