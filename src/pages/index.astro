---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="relative isolate min-h-dvh overflow-hidden sky">
		<div class="pointer-events-none absolute inset-0">
			<span class="star top-[8%] left-[12%]"></span>
			<span class="star top-[14%] left-[28%]"></span>
			<span class="star top-[6%] left-[47%]"></span>
			<span class="star top-[11%] left-[63%]"></span>
			<span class="star top-[7%] left-[81%]"></span>
			<span class="star top-[18%] left-[91%]"></span>
			<span class="star top-[22%] left-[8%]"></span>
			<span class="star top-[16%] left-[72%]"></span>
		</div>
		<div class="pointer-events-none absolute inset-0 overflow-hidden">
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
			<span class="flake"></span>
		</div>
		<div class="pointer-events-none absolute inset-0 overflow-hidden">
			<span class="wind"></span>
			<span class="wind"></span>
			<span class="wind"></span>
		</div>

		<div class="relative z-10 flex min-h-dvh flex-col items-center justify-center px-6 pb-44 pt-12 text-center">
			<p class="text-xs font-medium tracking-[0.35em] text-ice uppercase">
				Boulder, Colorado
			</p>
			<h1 class="mt-5 font-display text-[clamp(3rem,9vw,7rem)] leading-[0.9] font-semibold text-snow">
				Boulder
				<em class="mt-1 block font-display text-blush not-italic">Game Dev</em>
			</h1>
			<p class="mt-7 max-w-lg text-base leading-relaxed text-snow/80 sm:text-lg">
				A community meetup for people who make games — indies, studios, students, and anyone still figuring it out.
			</p>
			<p class="mt-8 text-sm tracking-wide text-snow/60">
				Playtests · Talks · Hangouts
			</p>
		</div>

		<svg
			class="pointer-events-none absolute inset-x-0 bottom-0 z-20 w-full"
			viewBox="0 0 1200 340"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			preserveAspectRatio="xMidYMax slice"
		>
			<path fill="#2a1850" d="M0 340V220L140 110L210 170L320 40L430 150L520 90L640 210L740 150L860 250L960 190L1080 270L1200 210V340H0Z" />
			<path fill="#f6f1e8" d="M320 40L348 86L292 78L320 40ZM520 90L546 128L498 122L520 90ZM140 110L158 136L122 132L140 110Z" />
			<path fill="#1a1038" d="M0 340V250L180 180L280 240L400 130L530 230L650 180L790 270L900 220L1040 290L1200 250V340H0Z" />
			<path fill="#10081f" d="M0 340V292L220 250L380 300L560 250L740 310L920 270L1200 310V340H0Z" />
			<g fill="#ff5d8f">
				<rect x="268" y="214" width="6" height="10" rx="1" />
				<rect x="264" y="224" width="14" height="6" rx="1" />
			</g>
		</svg>
	</main>
</Layout>
