---
import landscape from '../assets/landscape.webp';
import { description, help } from '../game/controls';
import { WIDTH, HEIGHT } from '../game/physics';
---

<div class="mountain-experience">
	<div class="landscape-frame">
		<img src={landscape.src} width={WIDTH} height={HEIGHT} alt="Pixel-art sunset over Boulder's Flatirons and pine forests." fetchpriority="high" decoding="async" />
		<canvas id="mountain-game" width={WIDTH} height={HEIGHT} tabindex="0" aria-label={description} aria-describedby="game-instructions">The optional climbing game requires a browser with canvas support.</canvas>
		<div class="summit-message" hidden><strong>Great climb!</strong><button id="climb-again" type="button">Play again?</button></div>
	</div>
	<div class="game-caption">
		<p id="game-instructions">{help.ready}</p>
	</div>
	<p id="game-status" class="sr-only" role="status" aria-live="polite"></p>
</div>

<script>
	const root = document.querySelector<HTMLElement>('.mountain-experience')!;
	const observer = new IntersectionObserver(([entry]) => {
		if (!entry.isIntersecting) return;
		observer.disconnect();
		import('../game/game').then(({ initGame }) => initGame(root));
	});
	observer.observe(root);
</script>
